[
  {
    "id": "gb-01",
    "site": "gutenberg-business",
    "prompt": "Change the homepage heading to Welcome to My Business",
    "assert": { "type": "preview_text", "page": "homepage", "contains": "Welcome to My Business" }
  },
  {
    "id": "gb-02",
