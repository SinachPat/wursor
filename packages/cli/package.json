{
  "name": "@originmain/cli",
  "version": "0.0.2",
  "private": false,
  "description": "Originmain CLI — reverse proxy for live React component inspection.",
  "type": "module",
  "bin": {
    "originmain": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@originmain/renderer": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
